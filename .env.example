# PayPal sandbox credentials - https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# Anthropic API key for risk scoring and the proposing agent
ANTHROPIC_API_KEY=

# Access tokens. Two roles: the agent files proposals, a reviewer decides them.
# Leaving these unset uses the demo values published in the README, which is fine for a
# sandbox demo and not for anything else. Set WARDEN_REQUIRE_TOKENS=true to refuse to
# start unless both are configured.
WARDEN_AGENT_TOKEN=
WARDEN_REVIEWER_TOKEN=
WARDEN_REVIEWER_NAME=
WARDEN_REQUIRE_TOKENS=

# Server
PORT=8787
WARDEN_DB=./warden.sqlite
