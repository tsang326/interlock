# PayPal sandbox credentials - https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# OpenAI API key for risk scoring and the proposing agent (default model gpt-4.1)
OPENAI_API_KEY=

# Access tokens. Two roles: the agent files proposals, a reviewer decides them.
# Leaving these unset uses the demo values published in the README, which is fine for a
# sandbox demo and not for anything else. Set INTERLOCK_REQUIRE_TOKENS=true to refuse to
# start unless both are configured.
INTERLOCK_AGENT_TOKEN=
INTERLOCK_REVIEWER_TOKEN=
INTERLOCK_REVIEWER_NAME=
INTERLOCK_REQUIRE_TOKENS=

# Which model each job uses. INTERLOCK_MODEL sets both; either can be pinned on its own.
# They are different jobs: the agent is a multi-turn conversation that has to hold its
# nerve against a prompt injection, while risk scoring is one short structured call per
# proposal — and scoring is what a development loop re-runs for the whole queue, so it is
# where a cheaper model saves the most. Measure before substituting: see the README.
INTERLOCK_MODEL=
INTERLOCK_AGENT_MODEL=
INTERLOCK_RISK_MODEL=

# How many agent runs start per window, and how long that window is. One run is a
# multi-turn model conversation, so on a public deployment this is the difference between
# a demo and an open tab at your expense. The window refills, so a process that is kept
# awake does not hand the whole period to whoever arrived first.
INTERLOCK_AGENT_RUN_BUDGET=25
INTERLOCK_AGENT_RUN_WINDOW_HOURS=24

# What those runs may cost, in US dollars, for the life of the process - counted from the
# usage the model API reports. This is the ceiling that actually guards the card: a run
# with large tool results costs several times what a short one does. Does not refill.
INTERLOCK_AGENT_SPEND_USD=4

# Server
PORT=8787
INTERLOCK_DB=./interlock.sqlite
